# OFFLINE environment template
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit .env or place secret values in EXPO_PUBLIC_* variables.

# ---------------------------------------------------------------------------
# Mobile-safe configuration
# These values are allowed to be bundled into the app. They are not secrets.
# The current app keeps its defaults in src/config/integrations.ts.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_OFFLINE_VOICE_LANGUAGE=en-US
EXPO_PUBLIC_OFFLINE_VOICE_RATE=0.5
EXPO_PUBLIC_OFFLINE_VOICE_PITCH=1
EXPO_PUBLIC_OFFLINE_VOICE_ENABLED=true
EXPO_PUBLIC_OFFLINE_MUSIC_ENABLED=true

# ---------------------------------------------------------------------------
# Future optional Spotify OAuth service only
# The current app only opens the installed Spotify app and needs no key.
# Never put a Spotify client secret in the mobile app.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
